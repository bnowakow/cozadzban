# Copy this file to .env.worker or your local worker's active .env.
# Keep it private. It contains the Facebook importer config and the remote write target.

POSTGRES_DB=cozadzban
# Use the same value as the server/Postgres deployment; generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_USER=cozadzban
POSTGRES_PORT=5432

SPRING_PROFILES_ACTIVE=local
# Worker keeps a long-lived Selenium browser so Facebook 2FA/manual login survives imports.
SPRING_DEVTOOLS_RESTART_ENABLED=false
APP_PORT=8086
APP_LOG_LEVEL=DEBUG
APP_LOG_FILE=logs/cozadzban-worker.log

COZADZBAN_BOOTSTRAP_ADMIN_EMAIL=
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_AUDIENCES=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=

# Analytics (optional - leave blank to disable tracking)
GOOGLE_ANALYTICS_MEASUREMENT_ID=
STATCOUNTER_PROJECT_ID=
STATCOUNTER_SECURITY_ID=

# Notifications are delivered by the server. The worker reports login-required
# events to APP_FACEBOOK_IMPORT_TARGET_RUN_PATH using machine auth.
APP_NOTIFICATIONS_ENABLED=true
APP_NOTIFICATIONS_PUSHOVER_APP_TOKEN=
# Server-side delivery only; if enabled here too, generate once with: openssl rand -base64 32
# Keep stable and private; changing it makes existing saved Pushover keys undecryptable.
APP_NOTIFICATIONS_ENCRYPTION_KEY=
APP_NOTIFICATIONS_PUSHOVER_BASE_URL=https://api.pushover.net
APP_NOTIFICATIONS_PUSHOVER_CONNECT_TIMEOUT=3s
APP_NOTIFICATIONS_PUSHOVER_READ_TIMEOUT=5s

MANAGEMENT_TRACING_EXPORT_ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# Facebook importer - shared settings
APP_FACEBOOK_IMPORT_MARKER_PHRASE=co za dzban
APP_FACEBOOK_IMPORT_TRANSLATED_MARKER_PHRASE=what a pitcher
APP_FACEBOOK_IMPORT_LANGUAGE=pl
# Facebook importer - scheduled Spring Batch worker
APP_FACEBOOK_IMPORT_RUN_TIMEOUT=1h
APP_FACEBOOK_IMPORT_SCHEDULE_ENABLED=true
APP_FACEBOOK_IMPORT_SCHEDULE_RUN_ON_STARTUP=false
APP_FACEBOOK_IMPORT_SCHEDULE_INTERVAL=8h
APP_FACEBOOK_IMPORT_SCHEDULE_INITIAL_DELAY=0s

# Facebook importer - upload targets
APP_FACEBOOK_IMPORT_TARGET_API_BASE_URL=https://cozadzban.pl
APP_FACEBOOK_IMPORT_TARGET_ARTICLE_PATH=/api/articles
APP_FACEBOOK_IMPORT_TARGET_PROPOSAL_PATH=/api/facebook-import/proposals
APP_FACEBOOK_IMPORT_TARGET_PROPOSAL_EXISTS_PATH=/api/facebook-import/proposals/exists
APP_FACEBOOK_IMPORT_TARGET_RUN_PATH=/api/facebook-import/runs
APP_FACEBOOK_IMPORT_TARGET_API_CONNECT_TIMEOUT=3s
APP_FACEBOOK_IMPORT_TARGET_API_READ_TIMEOUT=5m
APP_FACEBOOK_IMPORT_REJECTION_ARTIFACT_DIR=logs/facebook-import-rejections
# Facebook importer - machine-to-machine auth for remote writes
# Use the same value as the server's APP_MACHINE_AUTH_API_KEY.
APP_FACEBOOK_IMPORT_TARGET_API_KEY=
APP_FACEBOOK_IMPORT_TARGET_API_KEY_HEADER=X-CoZaDzban-M2M-Key

# Facebook Selenium import - browser-backed profile pass
APP_FACEBOOK_IMPORT_SELENIUM_ENABLED=true
APP_FACEBOOK_IMPORT_SELENIUM_PROFILE_URL=https://www.facebook.com/bartek.dobrowolski.nowakowski
APP_FACEBOOK_IMPORT_SELENIUM_USERNAME=
APP_FACEBOOK_IMPORT_SELENIUM_PASSWORD=
APP_FACEBOOK_IMPORT_SELENIUM_BROWSER=FIREFOX
APP_FACEBOOK_IMPORT_SELENIUM_HEADLESS=false
APP_FACEBOOK_IMPORT_SELENIUM_REUSE_BROWSER_ACROSS_RESTARTS=true
APP_FACEBOOK_IMPORT_SELENIUM_DRIVER_SESSION_FILE=logs/facebook-import-firefox-session.properties
APP_FACEBOOK_IMPORT_SELENIUM_SCROLLS=8
APP_FACEBOOK_IMPORT_SELENIUM_WAIT_AFTER_LOGIN=8s
APP_FACEBOOK_IMPORT_SELENIUM_WAIT_AFTER_PAGE_OPEN=5s
APP_FACEBOOK_IMPORT_SELENIUM_WAIT_AFTER_SCROLL=2s
APP_FACEBOOK_IMPORT_SELENIUM_MANUAL_LOGIN_TIMEOUT=15m

# Facebook Apify import - paid external retrieval, scheduled separately from Selenium
APP_FACEBOOK_IMPORT_APIFY_ENABLED=false
APP_FACEBOOK_IMPORT_APIFY_API_TOKEN=
APP_FACEBOOK_IMPORT_APIFY_BASE_URL=https://api.apify.com
APP_FACEBOOK_IMPORT_APIFY_ACTOR_ID=apify/facebook-posts-scraper
APP_FACEBOOK_IMPORT_APIFY_PROFILE_URL=https://www.facebook.com/bartek.dobrowolski.nowakowski/
APP_FACEBOOK_IMPORT_APIFY_ONLY_POSTS_NEWER_THAN=2 days
APP_FACEBOOK_IMPORT_APIFY_RESULTS_LIMIT=20
APP_FACEBOOK_IMPORT_APIFY_CAPTION_TEXT=false
APP_FACEBOOK_IMPORT_APIFY_MAX_COST_USD=0.10
APP_FACEBOOK_IMPORT_APIFY_SCHEDULE_ENABLED=true
APP_FACEBOOK_IMPORT_APIFY_SCHEDULE_INTERVAL=24h
APP_FACEBOOK_IMPORT_APIFY_CONNECT_TIMEOUT=10s
APP_FACEBOOK_IMPORT_APIFY_READ_TIMEOUT=15m
