# Copy this file to .env.server or your deployment's active .env.
# Keep it private. It contains deployment-specific values, but no live secrets.

POSTGRES_DB=cozadzban
# Generate for a new deployment with: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_USER=cozadzban
POSTGRES_PORT=5432

SPRING_PROFILES_ACTIVE=local
# Server can restart freely: it does not keep a long Selenium browser session.
SPRING_DEVTOOLS_RESTART_ENABLED=true
APP_PORT=8086
APP_LOG_LEVEL=DEBUG
#APP_LOG_LEVEL=INFO

COZADZBAN_BOOTSTRAP_ADMIN_EMAIL=
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_AUDIENCES=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=

# Analytics (optional - leave blank to disable tracking)
GOOGLE_ANALYTICS_MEASUREMENT_ID=
GOOGLE_ANALYTICS_API_SECRET=
STATCOUNTER_PROJECT_ID=
STATCOUNTER_SECURITY_ID=

# Notifications (optional - Pushover)
APP_NOTIFICATIONS_ENABLED=true
APP_NOTIFICATIONS_PUSHOVER_APP_TOKEN=
# Generate once with: openssl rand -base64 32
# Keep stable and private; changing it makes existing saved Pushover keys undecryptable.
APP_NOTIFICATIONS_ENCRYPTION_KEY=
APP_NOTIFICATIONS_PUSHOVER_BASE_URL=https://api.pushover.net
APP_NOTIFICATIONS_PUSHOVER_CONNECT_TIMEOUT=3s
APP_NOTIFICATIONS_PUSHOVER_READ_TIMEOUT=5s

MANAGEMENT_TRACING_EXPORT_ENABLED=true
MANAGEMENT_TRACING_EXPORT_ZIPKIN_ENABLED=true
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.10
MANAGEMENT_TRACING_EXPORT_ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans
MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://zipkin:9411/api/v2/spans

# facebook importer
APP_FACEBOOK_IMPORT_ENABLED=false


# Machine-to-machine API auth for remote article writes
APP_MACHINE_AUTH_ENABLED=true
APP_MACHINE_AUTH_HEADER_NAME=X-CoZaDzban-M2M-Key
# Generate with: openssl rand -base64 32
# Copy the same value to the worker's APP_FACEBOOK_IMPORT_TARGET_API_KEY.
APP_MACHINE_AUTH_API_KEY=
APP_MACHINE_AUTH_PRINCIPAL_EMAIL=facebook-import-bot@cozadzban.pl
